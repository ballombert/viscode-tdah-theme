{
  "name": "beadark",
  "publisher": "ballombert",
  "displayName": "BeaDark",
  "description": "Nine high-contrast color themes, including Neon, with optional, reversible focus and reading-font commands.",
  "icon": "assets/beadark-icon.png",
  "license": "MIT",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ballombert/viscode-tdah-theme.git"
  },
  "homepage": "https://github.com/ballombert/viscode-tdah-theme#readme",
  "bugs": {
    "url": "https://github.com/ballombert/viscode-tdah-theme/issues"
  },
  "keywords": ["theme", "dark", "light", "contrast", "accessibility", "focus", "neon", "readability", "typography"],
  "galleryBanner": {
    "color": "#191919",
    "theme": "dark"
  },
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "commands": [
      { "command": "beadark.chooseTypography", "title": "Choose Reading Typography", "category": "BeaDark" },
      { "command": "beadark.enableFocus", "title": "Enable Focus Settings", "category": "BeaDark" },
      { "command": "beadark.restoreSettings", "title": "Restore Reading or Focus Settings", "category": "BeaDark" },
      { "command": "beadark.showLegend", "title": "Show Syntax Color Legend", "category": "BeaDark" }
    ],
    "themes": [
      {
        "label": "Bea Theme Onyx",
        "uiTheme": "vs-dark",
        "path": "./themes/generated/bea-v2-onyx-color-theme.json"
      },
      {
        "label": "Bea Theme Deep Sea",
        "uiTheme": "vs-dark",
        "path": "./themes/generated/bea-v2-deepsea-color-theme.json"
      },
      {
        "label": "Bea Theme Forest Night",
        "uiTheme": "vs-dark",
        "path": "./themes/generated/bea-v2-forest-night-color-theme.json"
      },
      {
        "label": "Bea Theme Slate Focus",
        "uiTheme": "vs-dark",
        "path": "./themes/generated/bea-v2-slate-focus-color-theme.json"
      },
      {
        "label": "Bea Theme Dracula (Cool)",
        "uiTheme": "vs-dark",
        "path": "./themes/generated/bea-v2-dracula-color-theme.json"
      },
      {
        "label": "Bea Theme Polar",
        "uiTheme": "vs",
        "path": "./themes/generated/bea-v2-polar-color-theme.json"
      },
      {
        "label": "Bea Theme Paper Mint",
        "uiTheme": "vs",
        "path": "./themes/generated/bea-v2-paper-mint-color-theme.json"
      },
      {
        "label": "Bea Theme Neon Night",
        "uiTheme": "vs-dark",
        "path": "./themes/generated/bea-neon-night-color-theme.json"
      },
      {
        "label": "Bea Theme Neon Day",
        "uiTheme": "vs",
        "path": "./themes/generated/bea-neon-day-color-theme.json"
      }
    ]
  },
  "scripts": {
    "clean:vsix": "rm -f ./*.vsix",
    "build:vsix": "npm run check && vsce package --no-dependencies",
    "rebuild:vsix": "npm run clean:vsix && npm run build:vsix",
    "install:vsix": "bash -lc 'VSIX=$(ls -t ./*.vsix 2>/dev/null | head -n1); if [[ -z \"$VSIX\" ]]; then echo \"No .vsix file found. Run npm run build:vsix first.\"; exit 1; fi; code --install-extension \"$VSIX\" --force'",
    "test": "node --test test/*.test.js",
    "check": "npm run theme:build-all && npm run theme:check-contrast && npm test",
    "test:theme": "echo 'Run Theme Test (Extension Host) with F5; see docs/validation.md for the visual checklist.'",
    "theme:extract-palette": "node scripts/extract-theme-palette.js",
    "theme:apply-palette": "node scripts/apply-theme-palette.js",
    "theme:extract-and-apply": "npm run theme:extract-palette && npm run theme:apply-palette -- --template themes/extracted/template.jsonc --palette themes/extracted/palette.json --out themes/extracted/preview-color-theme.json",
    "theme:check-palettes": "node scripts/check-palette-policy.js --manifest themes/manifest.json",
    "theme:check-contrast": "node scripts/check-theme-contrast.js",
    "theme:build-all": "node scripts/build-all-themes.js --manifest themes/manifest.json"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.8"
    }
  }
}
