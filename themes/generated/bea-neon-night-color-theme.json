  "tokenColors": [
    {
      "name": "A - Commentaires",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9CAAC7"
      }
    },
    {
      "name": "A - Keywords / storage / modifiers",
      "scope": [
        "keyword",
        "storage",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#83ADFF"
      }
    },
    {
      "name": "A - Operateurs et ponctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#BBC5DB"
      }
    },
    {
      "name": "A - Chaines",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#80ED93"
      }
    },
    {
      "name": "A - Nombres et constantes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#C6A0FF"
      }
    },
    {
      "name": "A - Invalide",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F1929D"
      }
    },
    {
      "name": "A - Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#BBC5DB",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "B - Fonctions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#43DFEF"
      }
    },
    {
      "name": "B - Types et classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#FF8ADA"
      }
    },
    {
      "name": "B - Variables",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E7ECFA"
      }
    },
    {
      "name": "B - Parametres",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BBC5DB"
      }
    },
    {
      "name": "B - This / self",
      "scope": [
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#FF8ADA"
      }
    },
    {
      "name": "C - Titres markup",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#83ADFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C - Inline markup",
      "scope": [
        "markup.bold",
        "markup.italic",
        "markup.underline",
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#BBC5DB"
      }
    },
    {
      "name": "C - Liens et code inline",
      "scope": [
        "markup.link",
        "markup.underline.link",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#43DFEF"
      }
    },
    {
      "name": "C - Bloc de code",
      "scope": [
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#E7ECFA"
      }
